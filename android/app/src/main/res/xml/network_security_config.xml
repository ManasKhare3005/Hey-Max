<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS (tailscale serve) is the normal path. Plain HTTP is allowed only because traffic
     inside a tailnet is already encrypted by WireGuard (e.g. http://100.x.y.z:8765). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
